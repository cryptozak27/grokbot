# xAI Grok API (OpenAI-compatible). Required for live LLM stages; tests mock this.
GROK_API_KEY=

# Paper mode never broadcasts transactions. Do not put a private key here.
EXECUTION_MODE=paper

# Optional RPC overrides (defaults are public endpoints in config.yaml)
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
INK_RPC_URL=https://rpc-gel.inkonchain.com

# Optional lookback in blocks for paper polls (Robinhood ~0.1s/block)
POLL_LOOKBACK_BLOCKS=4000
